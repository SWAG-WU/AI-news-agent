# AI 前沿资讯收集 Agent - 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ====================
# 飞书机器人配置
# ====================
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/YOUR_WEBHOOK_URL_HERE
FEISHU_WEBHOOK_SECRET=YOUR_SECRET_HERE

# ====================
# DeepSeek API 配置 (用于摘要生成)
# ====================
# DeepSeek API Key (从 https://platform.deepseek.com/ 获取)
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名称 (deepseek-v4-flash / deepseek-v4-pro)
DEEPSEEK_MODEL=deepseek-v4-flash

# ====================
# GitHub 配置
# ====================
# GitHub Personal Access Token (用于获取更多API调用额度)
GITHUB_TOKEN=ghp_your_github_token

# ====================
# 代理配置 (可选)
# ====================
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# ====================
# 日志级别
# ====================
LOG_LEVEL=INFO

# ====================
# 时区
# ====================
TZ=Asia/Shanghai
